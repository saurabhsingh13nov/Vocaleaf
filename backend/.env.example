# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://vocaleaf:vocaleaf_dev@localhost:5432/vocaleaf
TEST_DATABASE_URL=postgresql+asyncpg://vocaleaf:vocaleaf_dev@localhost:5432/vocaleaf_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
DEBUG=true

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini image generation
GOOGLE_GENAI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Deprecated alias still accepted during migration:
# IMAGEN_MODEL=imagen-4.0-generate-001

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
ASSET_UPLOAD_URL_EXPIRE_SECONDS=600
ASSET_READ_URL_EXPIRE_SECONDS=300
VOICE_SAMPLE_MAX_FILE_SIZE_BYTES=26214400

# Google OAuth
GOOGLE_CLIENT_ID=
